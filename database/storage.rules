rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read access to all images
    match /images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    
    // Deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
